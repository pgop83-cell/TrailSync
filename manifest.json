{
  "id": "./",
  "name": "TrailSync",
  "short_name": "TrailSync",
  "version": "15.2.26",
  "description": "App trail con capa topo Trail / Pistas descargable offline, rutas BRouter, telemetría GPX y bloqueo lluvia.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#161b26",
  "theme_color": "#161b26",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open_gpx=1",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/xml": [
          ".gpx"
        ],
        "text/xml": [
          ".gpx"
        ],
        "application/octet-stream": [
          ".gpx"
        ],
        "*/*": [
          ".gpx"
        ]
      },
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./?share_gpx=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "gpx_file",
          "accept": [
            "*/*",
            ".gpx",
            "application/gpx+xml",
            "application/xml",
            "text/xml"
          ]
        }
      ]
    }
  }
}
